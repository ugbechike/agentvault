{
  "name": "@agentvault/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/server.js\"",
    "build": "tsup",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@agentvault/shared": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "3.2.7"
  }
}
