# AgentVault POC
# Copy to agentvault-poc/.env for the API and agentvault-poc/apps/web/.env.local for the web app.
# Do not commit real secrets. Do not put provider tokens in the browser bundle.
# Public registration is disabled. Demo accounts are created with pnpm seed:demo:production
# against the deployed database, not this file.

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (agentvault-poc/.env) ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# Public URL of this API. GitHub redirects here. Must match the OAuth app callback.
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# Postgres connection string. Required for accounts, connections, permissions, and audit logs.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agentvault

# Signs dashboard JWTs. At least 16 characters. Also used to encrypt provider credentials when
# CREDENTIAL_ENCRYPTION_KEY is unset.
JWT_SECRET=

# Optional dedicated key for provider credential encryption. Prefer this over JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=

# GitHub OAuth App. The user authorizes their own account. A shared PAT is not a connection.
# Callback URL to register on the OAuth app:
#   http://localhost:4000/api/oauth/github/callback
# Scopes requested: repo, read:user, user:email
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional override. Defaults to ${API_PUBLIC_URL}/api/oauth/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# Supabase OAuth is not wired. Leave these empty. The connector stays disconnected.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
