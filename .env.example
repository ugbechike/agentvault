# AgentVault POC
# Copy to agentvault-poc/.env for the API and agentvault-poc/apps/web/.env.local for the web app.
# Do not commit real secrets. The scaffold boots without any of the values below.

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Optional. The API starts without a database and no route queries it yet.
# Use the Supabase Postgres connection string when you are ready to run migrations.
DATABASE_URL=

# Future dashboard JWT signing key. Unused while auth routes return 501.
JWT_SECRET=

# Future provider OAuth. Unused. Never paste these into the browser demo.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
